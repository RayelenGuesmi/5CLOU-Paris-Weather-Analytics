		"cells": [
			{
				"cell_type": "code",
				"source": [
					"\n",
					"# Projet 5CLOU - Étape RAW vers SILVER\n",
					"# Configuration du chemin de stockage\n",
					"\n",
					"storage_account = \"st5clouweather\"\n",
					"container = \"synapse\"\n",
					"\n",
					"raw_path = f\"abfss://{container}@{storage_account}.dfs.core.windows.net/raw/\"\n",
					"silver_path = f\"abfss://{container}@{storage_account}.dfs.core.windows.net/silver/\"\n",
					"\n",
					"print(\"Source RAW :\", raw_path)\n",
					"print(\"Destination SILVER :\", silver_path)\n",
					""
				],
				"execution_count": 2
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"\n",
					"# Étape 2 - Explorer les données JSON Open-Meteo\n",
					"\n",
					"from pyspark.sql import functions as F\n",
					"\n",
					"# Lire les fichiers JSON du dossier RAW\n",
					"df_raw = (\n",
					"    spark.read\n",
					"    .option(\"multiLine\", \"true\")\n",
					"    .json(raw_path + \"*.json\")\n",
					")\n",
					"\n",
					"# Afficher le nombre d'enregistrements\n",
					"print(\"Nombre d'enregistrements :\", df_raw.count())\n",
					"\n",
					"# Afficher la structure des données\n",
					"print(\"\\nStructure des données :\")\n",
					"df_raw.printSchema()\n",
					"\n",
					"# Afficher les premières lignes\n",
					"print(\"\\nAperçu des données :\")\n",
					"display(df_raw.limit(10))\n",
					""
				],
				"execution_count": 3
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"\n",
					"# Étape 3 - Transformation RAW vers SILVER\n",
					"\n",
					"from pyspark.sql import functions as F\n",
					"\n",
					"# 1. Extraire les champs utiles du JSON imbriqué\n",
					"df_silver = df_raw.select(\n",
					"    F.to_timestamp(F.col(\"current.time\"), \"yyyy-MM-dd'T'HH:mm\").alias(\"measurement_time\"),\n",
					"    F.col(\"current.temperature_2m\").cast(\"double\").alias(\"temperature_c\"),\n",
					"    F.col(\"current.relative_humidity_2m\").cast(\"int\").alias(\"humidity_pct\"),\n",
					"    F.col(\"current.wind_speed_10m\").cast(\"double\").alias(\"wind_speed_kmh\"),\n",
					"    F.col(\"latitude\"),\n",
					"    F.col(\"longitude\"),\n",
					"    F.col(\"timezone\")\n",
					")\n",
					"\n",
					"# 2. Supprimer les mesures sans date ou température\n",
					"df_silver = df_silver.dropna(\n",
					"    subset=[\"measurement_time\", \"temperature_c\"]\n",
					")\n",
					"\n",
					"# 3. Supprimer les mesures répétées pour le même lieu\n",
					"df_silver = df_silver.dropDuplicates(\n",
					"    [\"measurement_time\", \"latitude\", \"longitude\"]\n",
					")\n",
					"\n",
					"# 4. Trier chronologiquement pour l'affichage\n",
					"df_silver = df_silver.orderBy(\"measurement_time\")\n",
					"\n",
					"print(\"Nombre de mesures RAW :\", df_raw.count())\n",
					"print(\"Nombre de mesures SILVER :\", df_silver.count())\n",
					"\n",
					"print(\"\\nSchéma SILVER :\")\n",
					"df_silver.printSchema()\n",
					"\n",
					"display(df_silver)\n",
					""
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"source": [
					"\n",
					"# Étape 3.5 - Contrôles qualité AVANT insertion dans SILVER\n",
					"\n",
					"from pyspark.sql import functions as F\n",
					"\n",
					"# 1. Vérifier les valeurs manquantes\n",
					"required_columns = [\n",
					"    \"measurement_time\",\n",
					"    \"temperature_c\",\n",
					"    \"humidity_pct\",\n",
					"    \"wind_speed_kmh\",\n",
					"    \"latitude\",\n",
					"    \"longitude\"\n",
					"]\n",
					"\n",
					"missing_condition = (\n",
					"    F.col(required_columns[0]).isNull()\n",
					")\n",
					"\n",
					"for column in required_columns[1:]:\n",
					"    missing_condition = (\n",
					"        missing_condition | F.col(column).isNull()\n",
					"    )\n",
					"\n",
					"null_count = df_silver.filter(missing_condition).count()\n",
					"\n",
					"# 2. Vérifier les clés dupliquées\n",
					"duplicate_count = (\n",
					"    df_silver\n",
					"    .groupBy(\n",
					"        \"measurement_time\",\n",
					"        \"latitude\",\n",
					"        \"longitude\"\n",
					"    )\n",
					"    .count()\n",
					"    .filter(F.col(\"count\") > 1)\n",
					"    .count()\n",
					")\n",
					"\n",
					"# 3. Vérifier les plages de valeurs\n",
					"invalid_count = df_silver.filter(\n",
					"    (F.col(\"humidity_pct\") < 0) |\n",
					"    (F.col(\"humidity_pct\") > 100) |\n",
